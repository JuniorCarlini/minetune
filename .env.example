# =============================================================================
# minetune — variáveis de INFRAESTRUTURA (portas, recursos, segredos, backup).
#
# As configurações do JOGO (tipo, versão, dificuldade, memória da JVM...) ficam
# em config/server.env e são editadas pelo painel. Rode `make init` para gerar
# este arquivo como .env com segredos aleatórios.
# =============================================================================

# Arquivos compose ativos (separados por ":"). Descomente overlays conforme o uso:
#   compose.s3-local.yaml  -> RustFS local como destino S3 dos backups
#   compose.tunnel.yaml    -> túnel playit.gg (CGNAT / sem abrir portas)
COMPOSE_FILE=compose.yaml
# COMPOSE_FILE=compose.yaml:compose.s3-local.yaml
# COMPOSE_FILE=compose.yaml:compose.tunnel.yaml

COMPOSE_PROJECT_NAME=minetune
# Identidade estável da instância. Usada como host dos snapshots do restic
# (mudar isso quebra a política de retenção dos backups antigos).
INSTANCE_NAME=minetune
TZ=America/Sao_Paulo

# --- Diretórios no host -------------------------------------------------------
DATA_DIR=./data
BACKUP_LOCAL_DIR=./backups
# Config do jogo (server.env, listas do Modrinth, patches). O painel escreve aqui.
CONFIG_DIR=./config

# --- Rede ---------------------------------------------------------------------
MC_PORT=25565
# Só é usada quando BEDROCK_CROSSPLAY=true em config/server.env
BEDROCK_PORT=19132
# 127.0.0.1 = painel acessível só pela máquina (use proxy reverso/EasyPanel com HTTPS).
# 0.0.0.0   = exposto na rede. Não faça isso sem HTTPS na frente.
PANEL_BIND=127.0.0.1
PANEL_PORT=8080
# Usuário do proxy do Docker. Padrão root (sem capabilities, read-only).
# Linux sem root: DOCKER_PROXY_USER=65534:$(stat -c %g /var/run/docker.sock)
# DOCKER_PROXY_USER=0:0

# --- Recursos -----------------------------------------------------------------
# Limite de RAM do container. A heap da JVM (MEMORY em config/server.env) deve
# ficar ~1–1.5 GB abaixo disso: a JVM usa memória fora da heap.
MC_MEMORY_LIMIT=6g
# Tag da imagem itzg: java25 atende Minecraft 26.x. Versões antigas: java21/java17/java8.
MC_IMAGE_TAG=java25

# --- Segredos (gerados por `make init`) ---------------------------------------
RCON_PASSWORD=
PANEL_PASSWORD=
PANEL_SESSION_SECRET=

# --- Backups (restic: incremental, deduplicado e criptografado) ---------------
# Senha de criptografia do repositório. PERDEU = PERDEU OS BACKUPS. Guarde fora do servidor.
RESTIC_PASSWORD=

# Destino. Padrão: repositório local (útil para começar; NÃO protege contra perda do disco).
RESTIC_REPOSITORY=/backups/restic
# Cloudflare R2:  s3:https://<ACCOUNT_ID>.r2.cloudflarestorage.com/<bucket>
# AWS S3:         s3:s3.<region>.amazonaws.com/<bucket>
# RustFS local:   s3:http://rustfs:9000/minetune-backups   (com compose.s3-local.yaml)
# RustFS/MinIO em outra máquina: s3:http://192.168.0.50:9000/minetune-backups
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# R2 usa "auto"; AWS usa a região do bucket.
AWS_DEFAULT_REGION=auto

# Agendamento e retenção
BACKUP_INITIAL_DELAY=5m
BACKUP_INTERVAL=6h
# Não faz backup repetido enquanto o servidor está vazio (nada mudou).
BACKUP_PAUSE_IF_NO_PLAYERS=true
BACKUP_RETENTION=--keep-last 4 --keep-daily 7 --keep-weekly 4 --keep-monthly 6
# Limite de upload em KiB/s (0 = sem limite)
RESTIC_LIMIT_UPLOAD=0
# O que NÃO entra no backup (tudo reconstruível: jar do servidor, bibliotecas, logs, cache).
BACKUP_EXCLUDES=/data/*.jar,/data/libraries,/data/versions,/data/cache,/data/logs,/data/crash-reports,/data/debug,/data/plugins/.paper-remapped,/data/.minetune,*.tmp

# --- RustFS (somente com compose.s3-local.yaml) --------------------------------
# Usa AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY acima como credenciais root.
RUSTFS_CONSOLE_PORT=9001

# --- playit.gg (somente com compose.tunnel.yaml) -------------------------------
PLAYIT_SECRET_KEY=
