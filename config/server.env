# =============================================================================
# Configuração do JOGO — gerenciada pelo painel (http://localhost:8080).
#
# Pode editar à mão: sintaxe shell, KEY="valor". Aplica no próximo restart do `mc`.
# Referência completa de variáveis: https://docker-minecraft-server.readthedocs.io
# Infra (portas, senhas, backup) fica no .env, não aqui.
# =============================================================================

# --- Servidor ---
TYPE="PAPER"
VERSION="26.2"
MEMORY="4G"
USE_AIKAR_FLAGS="true"
MOTD="Servidor minetune"
MAX_PLAYERS="20"
ONLINE_MODE="true"

# --- Mundo ---
LEVEL="world"
SEED=""
LEVEL_TYPE="minecraft:normal"
GENERATE_STRUCTURES="true"
SPAWN_PROTECTION="0"

# --- Jogabilidade ---
MODE="survival"
DIFFICULTY="normal"
HARDCORE="false"
PVP="true"
ALLOW_FLIGHT="false"
ENABLE_COMMAND_BLOCK="false"

# --- Desempenho ---
VIEW_DISTANCE="10"
SIMULATION_DISTANCE="6"
APPLY_PAPER_OPTIMIZATIONS="true"

# --- Acesso ---
ENABLE_WHITELIST="false"
ENFORCE_WHITELIST="true"

# --- Crossplay ---
BEDROCK_CROSSPLAY="false"
