{
  "name": "minetune-panel",
  "version": "0.3.4",
  "private": true,
  "type": "module",
  "description": "Painel de configuração e operação do servidor minetune",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "npm run dev:server & npm run dev:web; wait",
    "dev:server": "node --watch --env-file-if-exists=.env.local src/server/index.ts",
    "dev:web": "vite",
    "build": "vite build",
    "start": "node src/server/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "node --test 'src/**/*.test.ts'",
    "check": "npm run typecheck && npm test && npm run build"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.1",
    "hono": "^4.13.7",
    "yauzl": "3.4.0",
    "yazl": "3.3.1",
    "zod": "^4.6.2"
  },
  "devDependencies": {
    "@types/node": "^24.13.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/yauzl": "3.4.0",
    "@types/yazl": "3.3.1",
    "@vitejs/plugin-react": "^6.1.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tucano": "0.33.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.0"
  }
}
